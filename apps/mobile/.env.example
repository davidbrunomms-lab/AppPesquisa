# URL da API PersonalPro (sem barra no final).
# Emulador Android: use http://10.0.2.2:3333 · Dispositivo físico: IP da sua máquina na rede (ex.: http://192.168.0.10:3333)
EXPO_PUBLIC_API_URL=http://localhost:3333

# Login com Google (IDs de cliente OAuth do Google Cloud). Deixe vazio para ocultar o botão.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Links públicos
EXPO_PUBLIC_PRIVACY_URL=http://localhost:3000/privacidade
EXPO_PUBLIC_TERMS_URL=http://localhost:3000/termos
EXPO_PUBLIC_WEB_URL=http://localhost:3000
