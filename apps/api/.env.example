# Banco de dados
DATABASE_URL=postgresql://personalpro:personalpro@localhost:5432/personalpro

# Servidor
PORT=3333
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# JWT (gere segredos longos e aleatórios em produção: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-with-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Criptografia de campos sensíveis em repouso (32 bytes em base64: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=

# Login social (IDs de cliente OAuth separados por vírgula)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# E-mail (vazio = log no console)
SMTP_URL=
MAIL_FROM="PersonalPro <no-reply@personalpro.app>"

# Armazenamento: local | s3 (Supabase Storage e outros S3-compatíveis usam o driver s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
PUBLIC_API_URL=http://localhost:3333
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Push notifications (Firebase Cloud Messaging HTTP v1). Vazio = log no console.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# IA: rules (motor local) | openai-compatible
AI_PROVIDER=rules
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Pagamentos: manual | stripe | mercado_pago | asaas
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=
ASAAS_API_KEY=
